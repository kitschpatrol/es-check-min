{
	"name": "es-check-min",
	"version": "1.0.13",
	"description": "CLI tool and library to find the minimum compatible ECMAScript version of a JavaScript file.",
	"keywords": [
		"es-check",
		"cli",
		"version-detection",
		"npm-package",
		"ecmascript"
	],
	"homepage": "https://github.com/kitschpatrol/es-check-min",
	"bugs": "https://github.com/kitschpatrol/es-check-min/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/es-check-min.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"es-check-min": "dist/bin/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"@types/node": "~24.13.6",
		"@types/yargs": "^17.0.35",
		"es-check": "^9.8.1",
		"execa": "^10.1.0",
		"pkg-types": "^2.3.3",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.14.0",
		"brewpub": "^0.5.0",
		"bumpp": "^12.3.0",
		"mdat-plugin-cli-help": "^3.4.1",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"tsdown": "^0.23.1",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
